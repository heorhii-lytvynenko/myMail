POSTGRES_DB=mymail
POSTGRES_USER=mymail
POSTGRES_PASSWORD=change_me

DB_URL=jdbc:postgresql://localhost:5432/mymail
DB_USERNAME=mymail
DB_PASSWORD=change_me

AUTH0_DOMAIN=your_auth0_domain
AUTH0_API_IDENTIFIER=your_api_identifier
AUTH0_CLIENT_ID=your_application_client_id
AUTH0_CLIENT_SECRET=your_application_client_secret
AUTH0_CONNECTION=Username-Password-Authentication

RESEND_API_KEY=your_resend_api_key

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Enable only after callback registration and verification. This is a backend flag.
GOOGLE_INTEGRATION_ENABLED=false
GOOGLE_ALLOWED_REDIRECT_URIS=https://my-mail-front.vercel.app/api/integrations/google/callback
# Separate from the frontend cookie key. Generate a random 32-byte base64url key in a secret manager.
GOOGLE_TOKEN_ENCRYPTION_KEY=